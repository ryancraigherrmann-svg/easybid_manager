# Copy to .env and update DATABASE_URL to point to your local Postgres
DATABASE_URL="postgresql://username:password@localhost:5432/easybid"
PORT=4000
# Set to 'true' to run a lightweight test-seed on server startup (development only)
SEED_ON_STARTUP=true

# ── SMTP (Outlook / Office 365) ──
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ezbid@fourthpc.com
SMTP_PASS=your-email-password-here
SMTP_FROM="EasyBid <ezbid@fourthpc.com>"

# ── App URL (used in email links) ──
APP_URL=http://localhost:5173
